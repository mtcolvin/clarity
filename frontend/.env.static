# Build profile for the PUBLISHED STATIC DEMO (npm run build -- --mode static).
#
# There is no backend in this build. `build_static_demo.py` snapshots every GET response
# from a demo-store backend into a folder of files whose paths mirror the routes, and
# API_BASE points at that folder (relative, so the demo works from any subdirectory of
# any host). See the STATIC DEMO comment in src/api.js.
VITE_STATIC_DEMO=1
VITE_API_BASE=./api

# Where the published demo's header links point (PortfolioLinks). A fork publishing its own
# demo changes these or deletes them; with neither set, the header shows no links.
# Quoted: unquoted, a dotenv value ends at '#', which silently cut this to blot.world/.
VITE_DEMO_HOME_URL="https://blot.world/#projects"
VITE_DEMO_HOME_LABEL=blot.world
VITE_DEMO_REPO_URL=https://github.com/mtcolvin/clarity
# Show those links only when served from this host (not at the github.io address).
VITE_DEMO_LINKS_HOST=clarity.blot.world

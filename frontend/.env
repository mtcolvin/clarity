# Base URL of the FastAPI backend. Vite only exposes vars prefixed with VITE_.
# Use 127.0.0.1 (explicit IPv4), NOT localhost: uvicorn binds IPv4-only, but a
# browser may resolve `localhost` to IPv6 ::1 first and fail with a NetworkError
# (connection refused on ::1) instead of falling back to 127.0.0.1. Pinning IPv4
# here avoids that detour.
VITE_API_BASE=http://127.0.0.1:8000
